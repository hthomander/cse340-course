<%- include('../partials/headers') %>

<section class="page-container">
  <header class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle">Find a project and make a difference in your community.</p>
  </header>

  <section>
    <% if (loadError) { %>
      <p role="status">Project data is temporarily unavailable. Please try again later.</p>
    <% } else { %>
      <h2>Upcoming Service Projects</h2>
      <% if (projects.length > 0) { %>
        <ul>
          <% projects.forEach(project => { %>
            <li>
              <strong><%= project.title %></strong>
              <% if (project.description) { %>
                - <%= project.description %>
              <% } %>
              <% if (project.location) { %>
                <span>Location: <%= project.location %></span>
              <% } %>
              <% if (project.date) { %>
                <span>Date: <%= project.date %></span>
              <% } %>
              <% if (project.organization_name) { %>
                <span>Organized by: <%= project.organization_name %></span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No service projects found.</p>
      <% } %>
    <% } %>
  </section>
</section>

<%- include('../partials/footer') %>