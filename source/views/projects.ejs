<%- include('partials/headers') %>

<section class="page-container projects-page">
  <header class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle">Find a project and make a difference in your community.</p>
  </header>

  <section>
    <% if (loadError) { %>
      <p role="status">Project data is temporarily unavailable. Please try again later.</p>
    <% } else { %>
      <h2 class="projects-heading">Upcoming Service Projects</h2>
      <% if (projects.length > 0) { %>
        <ul class="project-list">
          <% projects.forEach(project => { %>
            <li class="project-item">
              <a class="project-card" href="/project/<%= project.project_id %>">
                <span class="project-title"><%= project.title %></span>
                <% if (project.description) { %>
                  <span><%= project.description %></span>
                <% } %>
                <span class="project-details">
                  <% if (project.location) { %>
                    <span>Location: <%= project.location %></span>
                  <% } %>
                  <% if (project.date) { %>
                    <span>Date: <%= project.date %></span>
                  <% } %>
                </span>
              </a>
              <p>
                Partner organization:
                <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
              </p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No service projects found.</p>
      <% } %>
    <% } %>
  </section>
</section>

<%- include('partials/footer') %>