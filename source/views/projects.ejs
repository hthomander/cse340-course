<%- include('../partials/headers') %>

<section class="page-container projects-page">
  <header class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle">Find a project and make a difference in your community.</p>
  </header>

  <section>
    <% if (loadError) { %>
      <p role="status">Project data is temporarily unavailable. Please try again later.</p>
    <% } else { %>
      <h2 class="projects-heading">Upcoming Service Projects</h2>
      <% if (projects.length > 0) { %>
        <% const projectGroups = projects.reduce((groups, project) => {
          const organizationName = project.organization_name || 'Other organizations';
          const group = groups.find(item => item.organizationName === organizationName);
          if (group) {
            group.projects.push(project);
          } else {
            groups.push({ organizationName, projects: [project] });
          }
          return groups;
        }, []); %>
        <% projectGroups.sort((a, b) => a.organizationName.localeCompare(b.organizationName)).forEach(group => { %>
          <section class="project-organization">
            <h3 class="project-organization-title"><%= group.organizationName %></h3>
            <ul class="project-list">
              <% group.projects.forEach(project => { %>
                <li class="project-item">
                  <strong class="project-title"><%= project.title %></strong>
                  <% if (project.description) { %>
                    - <%= project.description %>
                  <% } %>
                  <div class="project-details">
                    <% if (project.location) { %>
                      <span>Location: <%= project.location %></span>
                    <% } %>
                    <% if (project.date) { %>
                      <span>Date: <%= project.date %></span>
                    <% } %>
                  </div>
                </li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      <% } else { %>
        <p>No service projects found.</p>
      <% } %>
    <% } %>
  </section>
</section>

<%- include('../partials/footer') %>