<%- include('partials/headers') %>

<main>
    <h1>
        <%= title %>
        <% if (user && user.role_name === 'admin') { %>
            <span class="role-badge">Administrator</span>
        <% } %>
    </h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View registered users</a></p>
    <% } %>

</main>

<%- include('partials/footer') %>