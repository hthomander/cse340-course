<%- include('../partials/headers') %>

<section class="page-container">
  <header class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle">Meet the organizations creating service opportunities in our communities.</p>
  </header>

  <section>
    <% if (loadError) { %>
      <p role="status">Organization data is temporarily unavailable. Please try again later.</p>
    <% } else { %>
      <p>Here are a few of our partner organizations:</p>
      <ul>
        <% if (organizations.length > 0) { %>
          <% organizations.forEach(organization => { %>
            <li>
              <a href="/organizations/<%= organization.organization_id %>">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <strong><%= organization.name %></strong>
              </a>: <%= organization.contact_email %>
            </li>
          <% }) %>
        <% } else { %>
          <li>No partner organizations found.</li>
        <% } %>
      </ul>
    <% } %>
  </section>
</section>

<%- include('../partials/footer') %>