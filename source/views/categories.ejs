<%- include('partials/headers') %>

<div class="page-container">
  <header class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle">Explore project categories to find service opportunities that match your interests.</p>
  </header>
 <main>
  <% if (loadError) { %>
    <p role="status">Category data is temporarily unavailable. Please try again later.</p>
  <% } else if (categories.length > 0) { %>
    <section class="card-grid" aria-label="Service Project Categories">
      <% categories.forEach(category => { %>
        <article class="card">
          <div class="card-icon" aria-hidden="true">&#127793;</div>
          <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
          <p>Explore service projects filed under this category.</p>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <p>No categories found at this time.</p>
  <% } %>
</div>
</main>
<%- include('partials/footer') %>